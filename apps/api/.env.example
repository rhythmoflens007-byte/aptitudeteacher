# Copy this file to .env. Everything is optional: with no .env the app runs fully
# offline on a local SQLite database with built-in fallbacks instead of AI.

# Free key from https://aistudio.google.com/apikey — turns on the AI tutor,
# misconception diagnosis, micro-lessons, question generation, photo OCR and
# Hindi/Tamil explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried automatically when the main model is overloaded.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Any long random string. Change it before anyone else uses the app.
JWT_SECRET=dev-only-change-me

# Defaults to apps/api/aptitude.db. Point at Postgres (e.g. a free Supabase
# project) when you outgrow SQLite:
# DATABASE_URL=postgresql+psycopg://postgres:[password]@[host]:5432/postgres
